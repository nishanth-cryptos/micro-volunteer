# Firebase Web SDK config — copy to .env.local and fill values from
# Firebase Console > Project settings > Your apps > Web app config.
# NEVER commit .env or .env.local. NEVER paste real values here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only if Analytics is enabled
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "1" in .env.local to connect the frontend to local Firebase emulators
# (Auth :9099, Firestore :8080, Functions :5001, Storage :9199).
# Leave empty for production / real Firebase.
VITE_USE_EMULATORS=1
